import { Button, CheckBox, Slider } from "std-widgets.slint";
export { AppTray } from "tray.slint";

export component AppWindow inherits Window {
    title: "Ajustes de pantalla";
    icon: @image-url("icon.png");
    width: 360px;

    in-out property <float> saturation: 100;
    in-out property <float> contrast: 100;
    in-out property <float> brightness: 100;
    in property <bool> controls-enabled: true;
    in property <bool> tone-enabled: true;
    in property <string> tone-note: "";
    in property <string> error-text: "";
    callback saturation-changed(float);
    callback contrast-changed(float);
    callback brightness-changed(float);
    in-out property <bool> autostart: false;
    in property <bool> autostart-available: true;
    callback autostart-toggled(bool);
    callback reset-requested();
    callback settings-committed();

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            Text {
                text: "Saturación";
                vertical-alignment: center;
            }
            Text {
                text: "\{Math.round(root.saturation)}";
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Slider {
            minimum: 0;
            maximum: 400;
            step: 1;
            enabled: root.controls-enabled;
            value <=> root.saturation;
            changed(value) => {
                root.saturation-changed(value);
            }
            released(value) => {
                root.settings-committed();
            }
        }

        HorizontalLayout {
            Text {
                text: "Contraste";
                vertical-alignment: center;
            }
            Text {
                text: "\{Math.round(root.contrast)}";
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Slider {
            minimum: 50;
            maximum: 200;
            step: 1;
            enabled: root.controls-enabled && root.tone-enabled;
            value <=> root.contrast;
            changed(value) => {
                root.contrast-changed(value);
            }
            released(value) => {
                root.settings-committed();
            }
        }

        HorizontalLayout {
            Text {
                text: "Brillo";
                vertical-alignment: center;
            }
            Text {
                text: "\{Math.round(root.brightness)}";
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        Slider {
            minimum: 50;
            maximum: 200;
            step: 1;
            enabled: root.controls-enabled && root.tone-enabled;
            value <=> root.brightness;
            changed(value) => {
                root.brightness-changed(value);
            }
            released(value) => {
                root.settings-committed();
            }
        }

        CheckBox {
            text: "Iniciar con Windows";
            enabled: root.autostart-available;
            checked <=> root.autostart;
            toggled => {
                root.autostart-toggled(self.checked);
            }
        }

        Button {
            text: "Restablecer";
            enabled: root.controls-enabled;
            clicked => {
                root.reset-requested();
            }
        }

        if root.tone-note != "": Text {
            text: root.tone-note;
            color: #7f8c8d;
            wrap: word-wrap;
        }

        if root.error-text != "": Text {
            text: root.error-text;
            color: #c0392b;
            wrap: word-wrap;
        }
    }
}
