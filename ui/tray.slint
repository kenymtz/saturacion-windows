export component AppTray inherits SystemTrayIcon {
    icon: @image-url("icon.png");
    tooltip: "Ajustes de pantalla";

    callback open();
    callback quit();
    callback reset();

    clicked => {
        root.open();
    }

    Menu {
        MenuItem {
            title: "Abrir";
            activated => {
                root.open();
            }
        }
        MenuItem {
            title: "Restablecer";
            activated => {
                root.reset();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "Salir";
            activated => {
                root.quit();
            }
        }
    }
}
