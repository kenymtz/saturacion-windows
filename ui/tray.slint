export component AppTray inherits SystemTrayIcon {
    icon: @image-url("icon.png");
    in property <bool> english: false;
    tooltip: root.english ? "Display Settings" : "Ajustes de pantalla";

    callback open();
    callback quit();
    callback reset();

    clicked => {
        root.open();
    }

    Menu {
        MenuItem {
            title: root.english ? "Open" : "Abrir";
            activated => {
                root.open();
            }
        }
        MenuItem {
            title: root.english ? "Reset" : "Restablecer";
            activated => {
                root.reset();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: root.english ? "Quit" : "Salir";
            activated => {
                root.quit();
            }
        }
    }
}
